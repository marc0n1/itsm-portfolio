// Schema do ITSM Portfolio.
// Multi-tenant "preparado": toda entidade de negócio carrega organizationId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  REQUESTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users       User[]
  tickets     Ticket[]
  services    Service[]
  slaPolicies SlaPolicy[]
}

/// Metas de SLA por prioridade. Os prazos de cada chamado NÃO são gravados:
/// são calculados na leitura (src/lib/sla.ts), então mudar a política ou a
/// prioridade de um chamado recalcula tudo sem migrar dados.
model SlaPolicy {
  id                String   @id @default(cuid())
  organizationId    String
  priority          Priority
  responseMinutes   Int
  resolutionMinutes Int
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, priority])
}

/// Tipo de serviço do catálogo. `fields` guarda a definição do formulário
/// (lista de campos) e é validado com zod em src/lib/services.ts.
model Service {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String   @default("")
  defaultPriority Priority @default(MEDIUM)
  active          Boolean  @default(true)
  fields          Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(REQUESTER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  requested    Ticket[]     @relation("TicketRequester")
  assigned     Ticket[]     @relation("TicketAssignee")
  comments     Comment[]

  @@index([organizationId])
}

model Ticket {
  id               String       @id @default(cuid())
  number           Int          @default(autoincrement())
  organizationId   String
  title            String
  description      String
  status           TicketStatus @default(OPEN)
  priority         Priority     @default(MEDIUM)
  requesterId      String
  assigneeId       String?
  /// Primeira resposta pública da equipe (nota interna não conta).
  firstResponseAt  DateTime?
  /// Preenchido enquanto o chamado está em "Aguardando" (relógio de SLA parado).
  slaPausedAt      DateTime?
  /// Total de segundos já pausados; empurra os prazos do SLA.
  slaPausedSeconds Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?
  serviceId        String?
  /// Retrato das respostas do formulário do serviço: [{key,label,type,value}].
  /// Guardado com o rótulo para o chamado continuar legível se o serviço mudar.
  formData         Json?

  organization Organization @relation(fields: [organizationId], references: [id])
  requester    User         @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([serviceId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}
