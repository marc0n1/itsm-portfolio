// Schema do ITSM Portfolio.
// Multi-tenant "preparado": toda entidade de negócio carrega organizationId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  REQUESTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  ASSIGNED
  COMMENT
  STATUS
}

enum TicketEventType {
  CREATED
  STATUS
  PRIORITY
  ASSIGNEE
  ATTACHMENT_REMOVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users       User[]
  tickets     Ticket[]
  services    Service[]
  slaPolicies SlaPolicy[]
}

/// Metas de SLA por prioridade. Os prazos de cada chamado NÃO são gravados:
/// são calculados na leitura (src/lib/sla.ts), então mudar a política ou a
/// prioridade de um chamado recalcula tudo sem migrar dados.
model SlaPolicy {
  id                String   @id @default(cuid())
  organizationId    String
  priority          Priority
  responseMinutes   Int
  resolutionMinutes Int
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, priority])
}

/// Tipo de serviço do catálogo. `fields` guarda a definição do formulário
/// (lista de campos) e é validado com zod em src/lib/services.ts.
model Service {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String   @default("")
  defaultPriority Priority @default(MEDIUM)
  active          Boolean  @default(true)
  fields          Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(REQUESTER)
  /// Desativado = não entra mais (sessões abertas caem na próxima requisição),
  /// mas o histórico (chamados, comentários, eventos) continua apontando para ele.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  requested     Ticket[]       @relation("TicketRequester")
  assigned      Ticket[]       @relation("TicketAssignee")
  comments      Comment[]
  events        TicketEvent[]
  notifications Notification[]
  uploads       Attachment[]

  @@index([organizationId])
}

model Ticket {
  id               String       @id @default(cuid())
  number           Int          @default(autoincrement())
  organizationId   String
  title            String
  description      String
  status           TicketStatus @default(OPEN)
  priority         Priority     @default(MEDIUM)
  requesterId      String
  assigneeId       String?
  /// Primeira resposta pública da equipe (nota interna não conta).
  firstResponseAt  DateTime?
  /// Preenchido enquanto o chamado está em "Aguardando" (relógio de SLA parado).
  slaPausedAt      DateTime?
  /// Total de segundos já pausados; empurra os prazos do SLA.
  slaPausedSeconds Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?
  serviceId        String?
  /// Retrato das respostas do formulário do serviço: [{key,label,type,value}].
  /// Guardado com o rótulo para o chamado continuar legível se o serviço mudar.
  formData         Json?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  requester     User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee      User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  comments      Comment[]
  events        TicketEvent[]
  notifications Notification[]
  attachments   Attachment[]

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([serviceId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
}

/// Trilha de auditoria do chamado. `from`/`to` guardam um retrato legível
/// (status/prioridade em enum; responsável pelo NOME), para a linha do tempo
/// continuar correta mesmo que o usuário seja renomeado ou removido.
model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  actorId   String
  type      TicketEventType
  from      String?
  to        String?
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

/// Metadados do anexo. O arquivo fica em disco (storage/uploads/<storageKey>),
/// com nome aleatório: o nome original só existe aqui, para exibição.
/// `commentId` nulo = anexado na abertura do chamado.
model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  commentId  String?
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
  @@index([commentId])
}

/// Aviso dentro do app (sino). `message` é um retrato do texto no momento do
/// evento. Cada usuário só enxerga as suas; `readAt` nulo = não lida.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  ticketId  String
  type      NotificationType
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Tentativas de login que FALHARAM (limite contra força bruta). `email` é o
/// informado (minúsculo), exista ou não; `ip` vazio = IP não confiável/desconhecido.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  @@index([ip, createdAt])
}
